    {
      "name": "04. Transaction & Saga Transfer Service",
      "item": [
        {
          "name": "4.1 SAGA Transfer - Happy Path (Success)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountNumber\": \"1000123456\",\n  \"toAccountNumber\": \"1000654321\",\n  \"amount\": 5000000,\n  \"description\": \"Chuyen tien mua laptop Rikkei\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/transfers",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "transfers"]
            }
          }
        },
        {
          "name": "4.2 SAGA Transfer - Rollback (Simulate Failure & Compensating Refund)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountNumber\": \"1000123456\",\n  \"toAccountNumber\": \"1000654321\",\n  \"amount\": 2000000,\n  \"description\": \"Test Saga Compensating Rollback Flow\",\n  \"simulateCreditFailure\": true\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/transfers",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "transfers"]
            }
          }
        },
        {
          "name": "4.3 SAGA Transfer - Insufficient Funds (Debit Step Fails)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountNumber\": \"1000123456\",\n  \"toAccountNumber\": \"1000654321\",\n  \"amount\": 999999999,\n  \"description\": \"Test Insufficient Funds\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/transfers",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "transfers"]
            }
          }
        },
