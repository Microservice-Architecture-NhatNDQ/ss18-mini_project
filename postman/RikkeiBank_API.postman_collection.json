{
  "info": {
    "name": "RikkeiBank API - Microservices Suite",
    "_postman_id": "c1f72a6b-9c2e-4b95-a249-14a58ff0923a",
    "description": "Comprehensive Postman Collection for RikkeiBank Digital Banking API through Spring Cloud API Gateway with Saga Distributed Transactions, Redis Cache-Aside, JWT Authentication, and Resilience4j Circuit Breaker.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00. Infrastructure & Config",
      "item": [
        {
          "name": "Eureka Service Registry Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8761",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8761"
            }
          }
        },
        {
          "name": "Config Server - Identity Service Config",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8888/identity-service/default",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8888",
              "path": ["identity-service", "default"]
            }
          }
        },
        {
          "name": "API Gateway Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/actuator/health",
              "host": ["{{gatewayUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "01. Identity & Auth Service",
      "item": [
        {
          "name": "1.1 Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set(\"adminToken\", jsonData.accessToken);",
                  "    pm.environment.set(\"authToken\", jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@rikkeibank.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/login",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "1.2 Login as Teller",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set(\"tellerToken\", jsonData.accessToken);",
                  "    pm.environment.set(\"authToken\", jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teller01@rikkeibank.com\",\n  \"password\": \"teller123\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/login",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Login as Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set(\"customerToken\", jsonData.accessToken);",
                  "    pm.environment.set(\"authToken\", jsonData.accessToken);",
                  "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer01@gmail.com\",\n  \"password\": \"customer123\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/login",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "1.4 Refresh Token (Seamless Session)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/refresh",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "1.5 Register New Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newcustomer@gmail.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Hoang Thi Mau\",\n  \"phone\": \"0911223344\",\n  \"role\": \"ROLE_CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/register",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "1.6 Admin Force Logout (Revoke Token in Redis)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/force-logout/4",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "auth", "force-logout", "4"]
            }
          }
        }
      ]
    },
